# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Die .env-Datei NIE ins Git hochladen (steht in .gitignore).

# ---------------- OANDA ----------------
# Token: OANDA-Konto → "Mein Konto" → "API-Zugang verwalten" (Demokonto = fxTrade Practice)
OANDA_TOKEN=
OANDA_ACCOUNT_ID=          # z. B. 101-004-1234567-001
OANDA_ENV=practice         # practice = Demokonto (empfohlen!), live = Echtgeld
INSTRUMENT=XAU_USD
USD_PROXY_INSTRUMENT=EUR_USD
BOND_INSTRUMENT=USB10Y_USD # US-10J-Anleihe-CFD; leer lassen, falls bei dir nicht verfügbar

# ---------------- Konto & Risiko ----------------
ACCOUNT_SIZE=800           # wird genutzt, wenn der Kontostand nicht abrufbar ist
ACCOUNT_CURRENCY=EUR
USE_ACCOUNT_BALANCE=true   # echten Kontostand von OANDA verwenden
RISK_PCT=1.0               # Risiko pro Trade in % (Standard 1)
MAX_RISK_PCT=2.0           # Obergrenze, wird nie überschritten
MAX_LEVERAGE=20            # EU-Privatkunden: Gold max. 1:20
DAILY_LOSS_LIMIT_PCT=3.0   # nach 3 % Tagesverlust keine Signale mehr
MAX_MARGIN_SHARE=0.5       # max. Anteil des Kontos, der als Margin gebunden wird
MIN_TRADE_UNITS=1          # Fallback, falls OANDA die Mindestgröße nicht liefert

# ---------------- Signale ----------------
ENTRY_TF=M15               # M5 oder M15
TREND_TFS=H1,H4
STOP_ATR=1.5               # Stop = 1,5 × ATR
TARGET_ATR=2.0             # Ziel = 2,0 × ATR
MAX_HOLD_HOURS=4           # These verfällt nach 4 Std.
MAX_SPREAD_TO_STOP=0.20    # Spread darf höchstens 20 % des Stop-Abstands sein
EVENT_BLOCK_HOURS=1.5      # Sperre ±1,5 Std. um wichtige Termine (Filter "termine")
ROUND_STEP=50              # runde Marken alle 50 $
ADX_TREND=22               # ab hier gilt der Markt als Trend

# ---------------- Benachrichtigung ----------------
# ntfy: App "ntfy" installieren, ein geheimes Thema ausdenken (z. B. gold-x7k2p9) und abonnieren
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Telegram: Bot bei @BotFather anlegen, Chat-ID z. B. über @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COOLDOWN_MINUTES=60        # Pause nach einem gemeldeten Signal
MIN_STRENGTH_MAIN=3        # London/New York: so viele Faktoren müssen dafür sprechen
MIN_STRENGTH_OFF=5         # Asien/Nacht: nur starke Signale
QUIET_HOURS=               # z. B. 23:00-07:00 (lokale Zeit) – leer = keine Ruhezeit
NOTIFY_VARIANTS=*          # z. B. combo|*,donchian_20|alle  (nur diese Varianten melden)
NOTIFY_TOO_LARGE=true      # auch "zu groß für Konto"-Signale melden (deutlich markiert)
DAILY_SUMMARY_TIME=22:30
TIMEZONE=Europe/Berlin

# ---------------- Datenquellen ----------------
NEWS_ENABLED=true
CALENDAR_ENABLED=true
COT_ENABLED=true
POSITIONBOOK_ENABLED=true
EVENTS_CSV=data/events.csv

# ---------------- Claude (optional) ----------------
# Formuliert die These zusätzlich in natürlicher Sprache. Kostet API-Guthaben.
CLAUDE_THESIS=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------------- Betrieb & Backtest ----------------
DB_PATH=data/goldsignal.db
REPORT_PATH=reports/report.html
LOOP_INTERVAL_SEC=60
STALE_DATA_MINUTES=45
BACKTEST_DAYS=365
OOS_FRACTION=0.3
WALK_FORWARD_FOLDS=6
RANDOM_RUNS=300
MIN_TRADES_RELIABLE=30
